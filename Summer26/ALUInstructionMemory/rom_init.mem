// rom_init.mem
// 32 locations, 16-bit word width (4 hex digits per word)

0000    // Address 0x00 (0)
0001    // Address 0x01 (1)
0002    // Address 0x02 (2)
0004    // Address 0x03 (3)
0008    // Address 0x04 (4)
0010    // Address 0x05 (5)
0020    // Address 0x06 (6)
0040    // Address 0x07 (7)
0080    // Address 0x08 (8)
0100    // Address 0x09 (9)
0200    // Address 0x0A (10)
0400    // Address 0x0B (11)
0800    // Address 0x0C (12)
1000    // Address 0x0D (13)
2000    // Address 0x0E (14)
4000    // Address 0x0F (15)
8000    // Address 0x10 (16)
AAAA    // Address 0x11 (17)
5555    // Address 0x12 (18)
1234    // Address 0x13 (19)
5678    // Address 0x14 (20)
9ABC    // Address 0x15 (21)
DEF0    // Address 0x16 (22)
FEED    // Address 0x17 (23)
BEEF    // Address 0x18 (24)
CAFE    // Address 0x19 (25)
DEAD    // Address 0x1A (26)
00FF    // Address 0x1B (27)
FF00    // Address 0x1C (28)
0F0F    // Address 0x1D (29)
F0F0    // Address 0x1E (30)
FFFF    // Address 0x1F (31)